.gradle/
.kotlin/
.idea/
**/build/
local.properties
*.iml
captures/
benchmark-results/
testdata/open-images-miap-face-corpus/images/
core/ml/src/androidTest/assets/images/
core/ml/src/androidTest/assets/private_identity/

# Native build artifacts
.cxx/

# Verification evidence artifacts: build outputs, model/map binaries, tool virtualenvs
# and baseline source snapshots. These are reproducible and far too large for git
# (40 APKs alone are ~9 GB). Textual evidence already committed under docs/evidence
# stays tracked; only these artifact classes are excluded.
docs/evidence/**/*.apk
docs/evidence/**/*.ugmodel
docs/evidence/**/*.onnx
docs/evidence/**/*.zip
docs/evidence/**/*.pmtiles
docs/evidence/**/*.mbtiles
docs/evidence/**/*.key
docs/evidence/**/venv/
docs/evidence/**/baseline/
docs/evidence/**/model-assets/
docs/evidence/**/pet-assets/
docs/evidence/**/model-tools/
docs/evidence/**/pet-tools/
docs/evidence/**/maps-fixture/
docs/evidence/**/maps-renderer-ab/

# Local E2E/device evidence runs: large (APKs, corpora, device dumps), kept out of git.
# Curated evidence under generated/ and the M0 spike report stay tracked.
docs/evidence/*
!docs/evidence/generated/
!docs/evidence/M0_SPIKE_REPORT.md

# Rendered promo media (hundreds of MB); regenerate with docs/promo/render.mjs and soundtrack.py.
docs/promo/*.mp4
docs/promo/*.wav

# Signing material
*.jks
*.keystore
keystore.properties

# Generated Play store images (regenerate with store/play/compose_store_images.py)
store/play/images/
store/play/raw/*
!store/play/raw/MEDIA_LICENSES.md
__pycache__/
*.pyc
