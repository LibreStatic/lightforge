    <string name="local_analysis_privacy">Lightforge Studio peut analyser vos photos accessibles entièrement sur cet appareil. Rien n’est envoyé et vous pouvez arrêter l’analyse ou supprimer ses résultats à tout moment.</string>
    <string name="local_analysis_master">Utiliser l’analyse locale</string>
    <string name="local_analysis_master_summary">Contrôle les personnes et visages, le contenu et le texte des photos, ainsi que les collections d’animaux. Les éléments connus et inchangés ne sont pas analysés à nouveau.</string>
    <string name="local_analysis_minimum_battery">Batterie minimale pour l’analyse complète</string>
    <string name="local_analysis_battery_percent">%1$d%%</string>
    <string name="local_analysis_minimum_battery_summary">Sans chargeur, l’analyse complète ne s’exécute que lorsque Lightforge Studio est ouvert et que la batterie atteint ce niveau. La charge l’autorise toujours.</string>
    <string name="model_downloads_mobile_data">Télécharger les modèles avec les données mobiles</string>
    <string name="model_downloads_mobile_data_summary">Désactivé par défaut : les téléchargements et mises à jour de modèles sont suspendus sur les données mobiles et reprennent en Wi-Fi. Ils attendent aussi que l’appareil soit en charge ou que la batterie atteigne au moins le minimum ci-dessus.</string>
    <string name="model_download_waiting_network">En pause : en attente d’une connexion</string>
    <string name="model_download_waiting_wifi">En pause : en attente du Wi-Fi</string>
    <string name="model_download_waiting_battery">En pause : batterie sous le minimum d’analyse</string>
    <string name="local_analysis_features">Fonctions d’analyse</string>
    <string name="local_analysis_people">Personnes et visages</string>
    <string name="local_analysis_people_summary">Détecte les visages et regroupe localement les photos d’une même personne.</string>
    <string name="local_analysis_content">Contenu et texte des photos</string>
    <string name="local_analysis_content_summary">Crée des libellés recherchables et reconnaît le texte. Les collections d’animaux partagent ces libellés.</string>
    <string name="local_analysis_opt_out_title">L’analyse locale est prête</string>
    <string name="local_analysis_opt_out_body">Lightforge Studio peut organiser les personnes, les animaux, le contenu et le texte des photos entièrement sur cet appareil, uniquement avec les photos autorisées. L’indexation complète s’exécute pendant la charge ou lorsque Lightforge Studio est ouvert avec au moins 20 pour cent de batterie par défaut. Vous pouvez modifier ce niveau, désactiver l’analyse ou supprimer ses données dans Paramètres.</string>
    <string name="local_analysis_opt_out_accept">Activer l\'analyse locale</string>
    <string name="local_analysis_opt_out_decline">Pas maintenant</string>

