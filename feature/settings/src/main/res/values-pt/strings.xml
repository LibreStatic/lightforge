    <string name="local_analysis_privacy">O Lightforge Studio pode analisar suas fotos acessíveis inteiramente neste dispositivo. Nada é enviado e você pode interromper a análise ou excluir os resultados a qualquer momento.</string>
    <string name="local_analysis_master">Usar análise local</string>
    <string name="local_analysis_master_summary">Controla pessoas e rostos, conteúdo e texto das fotos e coleções de animais. Itens conhecidos sem alterações não são analisados novamente.</string>
    <string name="local_analysis_minimum_battery">Bateria mínima para análise completa</string>
    <string name="local_analysis_battery_percent">%1$d%%</string>
    <string name="local_analysis_minimum_battery_summary">Sem carregador, a análise completa só é executada enquanto o Lightforge Studio está aberto e a bateria está neste nível ou acima. O carregamento sempre permite a análise.</string>
    <string name="model_downloads_mobile_data">Baixar modelos com dados móveis</string>
    <string name="model_downloads_mobile_data_summary">Desativado por padrão: downloads e atualizações de modelos são pausados com dados móveis e retomados no Wi-Fi. Eles também aguardam até o dispositivo estar carregando ou a bateria estar no mínimo indicado acima ou acima dele.</string>
