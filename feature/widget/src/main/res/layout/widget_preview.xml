<?xml version="1.0" encoding="utf-8"?>
<!--
  Static, representative preview shown in the system widget picker via
  android:previewLayout (API 31+). It must not depend on runtime data: the
  picker inflates it in the launcher's process, so only framework semantic
  theme attributes are used, paired the same way as widget_gallery.xml
  (colorBackground/textColorPrimary, colorAccent for the photo tiles).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:contentDescription="@string/widget_content_description"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="4dp"
                android:src="@drawable/widget_preview_tile"
                android:scaleType="fitXY"
                android:importantForAccessibility="no" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="4dp"
                android:alpha="0.7"
                android:src="@drawable/widget_preview_tile"
                android:scaleType="fitXY"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:layout_marginTop="4dp"
                android:alpha="0.55"
                android:src="@drawable/widget_preview_tile"
                android:scaleType="fitXY"
                android:importantForAccessibility="no" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginTop="4dp"
                android:alpha="0.85"
                android:src="@drawable/widget_preview_tile"
                android:scaleType="fitXY"
                android:importantForAccessibility="no" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
