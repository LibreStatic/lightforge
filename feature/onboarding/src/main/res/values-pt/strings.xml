    <string name="onboarding_permissions_title">Escolha o que o Lightforge pode ver</string>
    <string name="onboarding_permissions_body">O Lightforge só lê suas mídias para mostrá-las a você. Nada é enviado e todas as permissões são opcionais.</string>
    <string name="onboarding_permission_media_title">Fotos e vídeos</string>
    <string name="onboarding_permission_media_body">Necessário para a linha do tempo, os álbuns e a pesquisa. O Android permite compartilhar tudo ou só os itens selecionados.</string>
    <string name="onboarding_permission_location_title">Local das fotos</string>
    <string name="onboarding_permission_location_body">Lê onde as fotos foram tiradas para montar o mapa de Lugares. O local nunca sai do seu dispositivo.</string>
