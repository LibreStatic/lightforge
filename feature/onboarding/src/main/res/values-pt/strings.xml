    <string name="onboarding_more_sync_body">Espelhe sua biblioteca em uma pasta ou faça backup nos seus próprios servidores.</string>
    <string name="onboarding_studio_title">Seu estúdio criativo</string>
    <string name="onboarding_studio_body">Ferramentas profissionais integradas. Tudo roda no seu dispositivo.</string>
    <string name="onboarding_studio_photo_title">Editor de fotos avançado</string>
    <string name="onboarding_studio_photo_body">Filtros, ajustes precisos e revelação RAW com recuperação de realces.</string>
    <string name="onboarding_studio_chip_filters">Filtros</string>
    <string name="onboarding_studio_video_title">Editor de vídeo avançado</string>
    <string name="onboarding_studio_video_body">Suporte completo a LOG: faça a correção de cor de gravações de câmeras Apple, Sony, Canon, Panasonic, DJI, Fujifilm, Nikon, Blackmagic, ARRI e RED, com exportação HDR em dispositivos compatíveis.</string>
    <string name="onboarding_studio_pdf_title">Estúdio PDF</string>
    <string name="onboarding_studio_pdf_body">Organize fotos e documentos em páginas, retrabalhe PDFs importados e exporte-os localmente.</string>
    <string name="onboarding_studio_collage_title">Criador de colagens</string>
    <string name="onboarding_studio_collage_body">Combine fotos em um único layout e ajuste o corte de cada uma.</string>
