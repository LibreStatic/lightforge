    <string name="onboarding_more_people_body">Explore rostos reconhecidos no dispositivo e um mapa offline de onde as fotos foram tiradas.</string>
    <string name="onboarding_more_memories_title">Memórias</string>
    <string name="onboarding_more_memories_body">Agrupe fotos em memórias e transforme-as em vídeos curtos.</string>
