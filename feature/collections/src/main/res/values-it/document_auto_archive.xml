<resources>
    <string name="document_auto_title">Archiviazione automatica</string>
    <string name="document_auto_explanation">I documenti corrispondenti lasciano Foto, ma restano in Documenti e negli album. Gli originali restano sul dispositivo. Preferiti e foto escluse vengono ignorati. Conserva e annulla riguardano la versione attuale.</string>
    <string name="document_auto_enabled">Archiviazione automatica attiva</string>
    <string name="document_auto_paused">Archiviazione automatica in pausa</string>
    <string name="document_auto_age">Età della foto</string>
    <string name="document_auto_any_age">Qualsiasi età</string>
    <string name="document_auto_review">Esamina corrispondenze</string>
    <string name="document_auto_pause">Sospendi archiviazione automatica</string>
    <string name="document_auto_undo">Annulla ultimo gruppo e sospendi</string>
    <string name="document_auto_preview">Foto da archiviare: %1$d</string>
    <string name="document_auto_future">Conferma questo gruppo e le corrispondenze future. I controlli locali avvengono circa ogni 15 minuti, secondo Android e la batteria. Nessun cloud o nuova analisi.</string>
    <string name="document_auto_more">Questa anteprima mostra le prime 100 corrispondenze. Le altre saranno elaborate nei gruppi successivi.</string>
    <string name="document_auto_empty">Nessuna corrispondenza attuale. Puoi attivare la regola per le foto future.</string>
    <string name="document_auto_keep">Conserva in Foto</string>
    <string name="document_auto_confirm">Archivia e attiva regola</string>
    <string name="document_auto_cancel">Annulla anteprima</string>
    <string name="document_auto_stale">Le corrispondenze o le impostazioni sono cambiate. Esaminale di nuovo prima di confermare.</string>
