<resources>
    <string name="document_auto_title">Arquivamento automático</string>
    <string name="document_auto_explanation">Os documentos correspondentes saem de Fotos, mas ficam em Documentos e álbuns. Os originais permanecem neste dispositivo. Favoritos e fotos excluídas da seleção são ignorados. Manter e desfazer se aplicam à versão atual.</string>
    <string name="document_auto_enabled">Arquivamento automático ativo</string>
    <string name="document_auto_paused">Arquivamento automático pausado</string>
    <string name="document_auto_age">Idade da foto</string>
    <string name="document_auto_any_age">Qualquer idade</string>
    <string name="document_auto_review">Revisar correspondências</string>
    <string name="document_auto_pause">Pausar arquivamento automático</string>
    <string name="document_auto_undo">Desfazer último lote e pausar</string>
    <string name="document_auto_preview">Fotos para arquivar: %1$d</string>
    <string name="document_auto_future">Confirme este lote e futuras correspondências. As verificações locais ocorrem aproximadamente a cada 15 minutos, conforme o Android e a bateria. Sem nuvem ou novas análises.</string>
    <string name="document_auto_more">Esta prévia mostra as primeiras 100 correspondências. As demais serão processadas em lotes posteriores.</string>
    <string name="document_auto_empty">Nenhuma correspondência agora. Você pode ativar a regra para fotos futuras.</string>
    <string name="document_auto_keep">Manter em Fotos</string>
    <string name="document_auto_confirm">Arquivar e ativar regra</string>
    <string name="document_auto_cancel">Cancelar prévia</string>
    <string name="document_auto_stale">As correspondências ou configurações mudaram. Revise novamente antes de confirmar.</string>
    <string name="document_auto_active_rule">Regra salva: %1$s · %2$d dias</string>
